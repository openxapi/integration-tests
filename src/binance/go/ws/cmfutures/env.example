# Binance CMFUTURES WebSocket API Configuration
# Copy this file to env.local and fill in your credentials

# API credentials (required for authenticated endpoints)
export BINANCE_API_KEY="your-api-key-here"
export BINANCE_SECRET_KEY="your-secret-key-here"

# Optional: Use RSA or Ed25519 authentication instead of HMAC
# export BINANCE_RSA_API_KEY="rsa-api-key"
# export BINANCE_RSA_PRIVATE_KEY_PATH="/path/to/your/rsa-private-key.pem"
# export BINANCE_RSA_PRIVATE_KEY_PASSPHRASE="optional-passphrase"
# export BINANCE_ED25519_API_KEY="ed25519-api-key"
# export BINANCE_ED25519_PRIVATE_KEY_PATH="/path/to/your/ed25519-private-key.pem"
# export BINANCE_ED25519_PRIVATE_KEY_PASSPHRASE="optional-passphrase"

# Server configuration (optional, defaults to testnet endpoints)
# export BINANCE_CMFUTURES_WS_SERVER="wss://testnet.binancefuture.com/ws-dapi/v1"
# export BINANCE_CMFUTURES_REST_SERVER="https://testnet.binancefuture.com"

# Test configuration (optional)
# export BINANCE_CMFUTURES_SYMBOL="BTCUSD_PERP"
# export EVENT_WAIT_SECS="20"
# export WS_THROTTLE_MS="300"
